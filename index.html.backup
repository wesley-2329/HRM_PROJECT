  <!-- 3. EMPLOYEE PORTAL -->
  <div id="emp-app" class="app-layout" style="display:none;">
    <aside class="sidebar" id="emp-sidebar">
      <div>
        <div class="sidebar-header">
          <i class="fa-solid fa-layer-group"></i>
          <span class="logo-text">TalentSphere</span>
        </div>
        <div class="profile-card">
          <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150" alt="Avatar">
          <div class="profile-info">
            <h4>Arjun Mehta</h4>
            <p>Software Engineer</p>
          </div>
        </div>
        <nav class="nav-list">
          <a class="nav-item active" onclick="switchEmpModule('emp-dashboard', this)"><i class="fa-solid fa-gauge-high"></i><span class="nav-text">My Dashboard</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-profile', this)"><i class="fa-solid fa-circle-user"></i><span class="nav-text">My Profile</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-documents', this)"><i class="fa-solid fa-folder-open"></i><span class="nav-text">My Documents</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-attendance', this)"><i class="fa-solid fa-calendar-check"></i><span class="nav-text">Attendance</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-payroll', this)"><i class="fa-solid fa-indian-rupee-sign"></i><span class="nav-text">Payroll & Salary</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-pip', this)"><i class="fa-solid fa-star-half-stroke"></i><span class="nav-text">PIP & Performance</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-learning', this)"><i class="fa-solid fa-book-open"></i><span class="nav-text">Learning & Dev</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-tasks', this)"><i class="fa-solid fa-list-check"></i><span class="nav-text">Tasks</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-meetings', this)"><i class="fa-solid fa-video"></i><span class="nav-text">Meetings</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-notifications', this)"><i class="fa-solid fa-bell"></i><span class="nav-text">Notifications</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-helpdesk', this)"><i class="fa-solid fa-headset"></i><span class="nav-text">Helpdesk / Support</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-policies', this)"><i class="fa-solid fa-building-columns"></i><span class="nav-text">Company Policies</span></a>
          <a class="nav-item" onclick="switchEmpModule('emp-settings', this)"><i class="fa-solid fa-gear"></i><span class="nav-text">Settings</span></a>
        </nav>
      </div>
      <div>
        <a class="nav-item signout" onclick="handleLogout()"><i class="fa-solid fa-right-from-bracket"></i><span class="nav-text">Sign Out</span></a>
        <button class="sidebar-toggle" onclick="toggleSidebar('emp')"><i class="fa-solid fa-chevron-left" id="emp-chevron"></i></button>
      </div>
    </aside>

    <main class="main-content">
      <header class="top-navbar">
        <div style="display:flex; align-items:center; gap:16px;">
          <button class="nav-icon-btn" style="display:none;" id="emp-hamburger" onclick="toggleMobileSidebar('emp')"><i class="fa-solid fa-bars"></i></button>
          <h2 style="font-weight:700; font-size:1.25rem;" id="emp-page-title">My Dashboard</h2>
        </div>
        <div style="font-size:0.9rem; font-weight:600; color:hsl(var(--text-secondary));">
          Session ID: <span class="badge badge-success">EMP-2047 ACTIVE</span>
        </div>
        <div class="nav-actions">
          <button class="nav-icon-btn" onclick="switchEmpModule('emp-notifications')">
            <i class="fa-solid fa-bell"></i>
            <span class="badge-count" id="emp-nav-unread-count">8</span>
          </button>
          <button class="nav-icon-btn" onclick="toggleDarkMode()"><i class="fa-solid fa-moon"></i></button>
          <div class="user-dropdown-btn" onclick="toggleDropdown('emp-dd')">
            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150" alt="Profile">
            <i class="fa-solid fa-chevron-down" style="font-size:0.75rem;"></i>
          </div>
          <div class="dropdown-menu" id="emp-dd">
            <a class="dropdown-item" onclick="switchEmpModule('emp-profile')"><i class="fa-solid fa-user"></i> My Profile</a>
            <a class="dropdown-item" onclick="switchEmpModule('emp-settings')"><i class="fa-solid fa-gear"></i> Settings</a>
            <a class="dropdown-item" onclick="handleLogout()"><i class="fa-solid fa-right-from-bracket"></i> Log Out</a>
          </div>
        </div>
      </header>

      <div class="module-viewport">
        <!-- EMP: Dashboard -->
        <section id="emp-mod-emp-dashboard" class="emp-module">
          <div class="card" style="background: linear-gradient(135deg, hsl(var(--primary)) 0%, #4f46e5 100%); color:#fff; border:none; padding:20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
              <div>
                <h3 style="font-size:1.4rem; font-weight:700; margin-bottom:4px;">Welcome to TalentSphere Employee Portal</h3>
                <p style="opacity:0.9; font-size:0.875rem;">Today is <span id="emp-dash-date">Monday, 8 June 2026</span></p>
              </div>
              <div style="display:flex; gap:8px;" class="quick-links">
                <button class="btn btn-secondary" style="color:#fff; background:rgba(255,255,255,0.15); border:none;" onclick="switchEmpModule('emp-profile')">My Profile</button>
                <button class="btn btn-secondary" style="color:#fff; background:rgba(255,255,255,0.15); border:none;" onclick="openModal('raise-ticket-modal')">Raise Ticket</button>
                <button class="btn btn-secondary" style="color:#fff; background:rgba(255,255,255,0.15); border:none;" onclick="switchEmpModule('emp-attendance')">Apply Leave</button>
                <button class="btn btn-secondary" style="color:#fff; background:rgba(255,255,255,0.15); border:none;" onclick="switchEmpModule('emp-payroll')">View Payslip</button>
              </div>
            </div>
          </div>

          <div class="metric-grid">
            <div class="metric-card primary">
              <div>
                <span class="metric-label">Attendance This Month</span>
                <div class="metric-val">22/24 Days</div>
                <span class="badge badge-success">Punctual</span>
              </div>
              <div class="metric-icon-box"><i class="fa-solid fa-calendar-check"></i></div>
            </div>
            <div class="metric-card success">
              <div>
                <span class="metric-label">Leave Balance</span>
                <div class="metric-val">8 Days</div>
                <span style="font-size:0.75rem; color:var(--text-secondary);">Earned & Casual</span>
              </div>
              <div class="metric-icon-box"><i class="fa-solid fa-plane"></i></div>
            </div>
            <div class="metric-card info">
              <div>
                <span class="metric-label">Pending Tasks</span>
                <div class="metric-val" id="emp-dash-task-count">2</div>
                <span style="font-size:0.75rem; color:var(--text-secondary);">Assigned tasks</span>
              </div>
              <div class="metric-icon-box"><i class="fa-solid fa-list-check"></i></div>
            </div>
            <div class="metric-card warning">
              <div>
                <span class="metric-label">Upcoming Meetings</span>
                <div class="metric-val">2 Meetings</div>
                <span style="font-size:0.75rem; color:var(--text-secondary);">Scheduled for today</span>
              </div>
              <div class="metric-icon-box"><i class="fa-solid fa-video"></i></div>
            </div>
          </div>

          <div class="dashboard-layout">
            <div>
              <div class="card">
                <div class="card-title">Attendance Ratio Breakdown</div>
                <div class="chart-container">
                  <canvas id="empAttendanceDonut"></canvas>
                </div>
              </div>
              <div class="card">
                <div class="card-title">Working Hours Trend (Last 7 Days)</div>
                <div class="chart-container">
                  <canvas id="empHoursLine"></canvas>
                </div>
              </div>
              <div class="card">
                <div class="card-title">Assigned Tasks</div>
                <div style="display:flex; flex-direction:column; gap:12px;" id="emp-dash-tasks"></div>
              </div>
            </div>

            <div>
              <div class="card">
                <div class="card-title">Upcoming Meetings</div>
                <div style="display:flex; flex-direction:column; gap:12px;" id="emp-dash-meetings"></div>
              </div>
              <div class="card">
                <div class="card-title">Training Reminders</div>
                <div style="background:hsl(var(--bg-main)); padding:16px; border-radius:var(--radius-md);" id="emp-dash-training-card">
                  <!-- Dynamic training reminder -->
                </div>
              </div>
              <div class="card">
                <div class="card-title">Latest Notifications</div>
                <div style="display:flex; flex-direction:column; gap:12px;" id="emp-dash-notifs"></div>
              </div>
              <div class="card">
                <div class="card-title">Performance & PIP Overview</div>
                <div>
                  <div style="display:flex; justify-content:space-between; margin-bottom:8px; font-size:0.875rem;">
                    <span>Current Rating: 4.2 / 5.0</span>
                    <span class="badge badge-success">PIP Status: Not Initiated</span>
                  </div>
                  <div style="color:var(--warning); font-size:0.95rem; margin-bottom:12px;">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star-half-stroke"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- EMP: Profile -->
        <section id="emp-mod-emp-profile" class="emp-module" style="display:none;">
          <div style="display:flex; gap:12px; margin-bottom:20px;">
            <button class="btn btn-primary" id="btn-profile-personal" onclick="switchProfileTab('personal')">Personal Info</button>
            <button class="btn btn-secondary" id="btn-profile-professional" onclick="switchProfileTab('professional')">Professional Info</button>
          </div>

          <div id="profile-tab-personal">
            <div class="card">
              <div class="card-title">Personal Details</div>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:18px;" id="profile-personal-fields">
                <!-- Javascript fills these in dynamically -->
              </div>
              <div style="margin-top:20px; display:flex; gap:12px;">
                <button class="btn btn-primary" onclick="makeProfileEditable()">Edit Profile</button>
                <button class="btn btn-secondary" onclick="showToast('Profile image updated mock successfully.', 'success')">Upload Profile Picture</button>
                <button class="btn btn-secondary" onclick="openModal('raise-ticket-modal')">Raise Ticket</button>
              </div>
            </div>
          </div>

          <div id="profile-tab-professional" style="display:none;">
            <div class="card">
              <div class="card-title">Professional Context (Read Only)</div>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:18px;">
                <div>
                  <span style="font-size:0.8rem; color:var(--text-secondary);">Department</span>
                  <p style="font-weight:600; margin-top:4px;">Engineering</p>
                </div>
                <div>
                  <span style="font-size:0.8rem; color:var(--text-secondary);">Designation</span>
                  <p style="font-weight:600; margin-top:4px;">Software Engineer</p>
                </div>
                <div>
                  <span style="font-size:0.8rem; color:var(--text-secondary);">Reporting Manager</span>
                  <p style="font-weight:600; margin-top:4px;">Priya Nair</p>
                </div>
                <div>
                  <span style="font-size:0.8rem; color:var(--text-secondary);">Joining Date</span>
                  <p style="font-weight:600; margin-top:4px;">12 Jan 2022</p>
                </div>
                <div>
                  <span style="font-size:0.8rem; color:var(--text-secondary);">Experience</span>
                  <p style="font-weight:600; margin-top:4px;">4 Years 5 Months</p>
                </div>
                <div>
                  <span style="font-size:0.8rem; color:var(--text-secondary);">Employment Type</span>
                  <p style="font-weight:600; margin-top:4px;">Full-Time (Permanent)</p>
                </div>
                <div>
                  <span style="font-size:0.8rem; color:var(--text-secondary);">HR Status</span>
                  <p style="margin-top:4px;"><span class="badge badge-success">Approved</span></p>
                </div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-title">My Tickets</div>
            <div class="table-responsive">
              <table class="custom-table">
                <thead>
                  <tr>
                    <th>Ticket ID</th>
                    <th>Subject</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Raised On</th>
                    <th>HR Response</th>
                  </tr>
                </thead>
                <tbody id="emp-profile-tickets-tbody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- EMP: Documents -->
        <section id="emp-mod-emp-documents" class="emp-module" style="display:none;">
          <div class="emp-grid" id="emp-documents-grid">
            <!-- Populated dynamically with document cards -->
          </div>
        </section>

        <!-- EMP: Attendance -->
        <section id="emp-mod-emp-attendance" class="emp-module" style="display:none;">
          <div style="display:flex; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
            <button class="btn btn-primary" id="emp-att-tab-overview" onclick="switchEmpAttTab('overview')">Overview</button>
            <button class="btn btn-secondary" id="emp-att-tab-apply" onclick="switchEmpAttTab('apply')">Apply Leave</button>
            <button class="btn btn-secondary" id="emp-att-tab-history" onclick="switchEmpAttTab('history')">Leave History</button>
            <button class="btn btn-secondary" id="emp-att-tab-timesheet" onclick="switchEmpAttTab('timesheet')">Timesheet</button>
            <button class="btn btn-secondary" id="emp-att-tab-analysis" onclick="switchEmpAttTab('analysis')">Analysis</button>
          </div>

          <!-- Overview Sub-tab -->
          <div id="emp-att-sect-overview">
            <div class="dashboard-layout">
              <div>
                <div class="card">
                  <div class="card-title">Today's Attendance Status</div>
                  <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span class="badge badge-success" style="font-size:1.1rem; padding:8px 16px;">Present Today</span>
                    <div>
                      <span style="font-size:0.85rem; color:var(--text-secondary);">Today's Hours</span>
                      <h3 style="font-size:1.5rem;" id="emp-live-hours">09:00 Hrs</h3>
                    </div>
                  </div>
                </div>
                <div class="card">
                  <div class="card-title">Monthly Calendar View</div>
                  <div style="display:grid; grid-template-columns:repeat(7, 1fr); gap:8px; text-align:center; font-weight:600;" id="emp-attendance-calendar">
                    <!-- Loaded dynamically via js -->
                  </div>
                </div>
              </div>
              <div>
                <div class="card">
                  <div class="card-title">Upcoming Holidays</div>
                  <div style="display:flex; flex-direction:column; gap:10px;" id="emp-holidays-list"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Apply Leave Sub-tab -->
          <div id="emp-att-sect-apply" style="display:none;">
            <div class="card">
              <div class="card-title">Request Leave</div>
              <form id="emp-leave-form" onsubmit="handleEmpLeaveForm(event)">
                <div class="form-group">
                  <label>Leave Type</label>
                  <select id="emp-leave-type" class="form-control">
                    <option value="Casual">Casual Leave</option>
                    <option value="Sick">Sick Leave</option>
                    <option value="Earned">Earned Leave</option>
                  </select>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                  <div class="form-group">
                    <label>From Date</label>
                    <input type="date" id="emp-leave-from" class="form-control" required>
                  </div>
                  <div class="form-group">
                    <label>To Date</label>
                    <input type="date" id="emp-leave-to" class="form-control" required>
                  </div>
                </div>
                <div class="form-group">
                  <label>Reason</label>
                  <textarea id="emp-leave-reason" class="form-control" style="height:80px;" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Submit Application</button>
              </form>
            </div>
          </div>

          <!-- Leave History Sub-tab -->
          <div id="emp-att-sect-history" style="display:none;">
            <div class="card">
              <div class="card-title">My Leave History</div>
              <div class="table-responsive">
                <table class="custom-table">
                  <thead>
                    <tr>
                      <th>Date Range</th>
                      <th>Type</th>
                      <th>Days</th>
                      <th>Reason</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="emp-leave-history-tbody"></tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Timesheet Sub-tab -->
          <div id="emp-att-sect-timesheet" style="display:none;">
            <div class="card">
              <div class="card-title">Weekly Timesheet</div>
              <div class="table-responsive">
                <table class="custom-table">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Clock In</th>
                      <th>Clock Out</th>
                      <th>Hours Worked</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody id="emp-timesheet-tbody"></tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Analysis Sub-tab -->
          <div id="emp-att-sect-analysis" style="display:none;">
            <div class="card">
              <div class="card-title">Monthly Attendance Rate (%)</div>
              <div class="chart-container">
                <canvas id="empAnalysisBar"></canvas>
              </div>
            </div>
          </div>
        </section>

        <!-- EMP: Payroll -->
        <section id="emp-mod-emp-payroll" class="emp-module" style="display:none;">
          <div class="metric-grid">
            <div class="metric-card primary">
              <div>
                <span class="metric-label">Gross Salary</span>
                <div class="metric-val">₹85,000</div>
              </div>
              <div class="metric-icon-box"><i class="fa-solid fa-money-bill-wave"></i></div>
            </div>
            <div class="metric-card danger">
              <div>
                <span class="metric-label">Total Deductions</span>
                <div class="metric-val">₹12,750</div>
              </div>
              <div class="metric-icon-box"><i class="fa-solid fa-file-invoice-dollar"></i></div>
            </div>
            <div class="metric-card success">
              <div>
                <span class="metric-label">Net Salary</span>
                <div class="metric-val">₹72,250</div>
              </div>
              <div class="metric-icon-box"><i class="fa-solid fa-wallet"></i></div>
            </div>
          </div>

          <div class="dashboard-layout">
            <div>
              <div class="card">
                <div class="card-title">Deductions Proportion</div>
                <div class="chart-container">
                  <canvas id="empDeductionPie"></canvas>
                </div>
              </div>
              <div class="card">
                <div class="card-title">Monthly Earnings Breakdown</div>
                <div class="chart-container">
                  <canvas id="empEarningsBar"></canvas>
                </div>
              </div>
            </div>
            <div>
              <div class="card">
                <div class="card-title">Monthly Payslips</div>
                <div class="table-responsive">
                  <table class="custom-table" style="font-size:0.8rem;">
                    <thead>
                      <tr>
                        <th>Month</th>
                        <th>Net Paid</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody id="emp-payslips-tbody"></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- EMP: PIP & Performance -->
        <section id="emp-mod-emp-pip" class="emp-module" style="display:none;">
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:24px;">
            <div class="card">
              <div class="card-title">Current Performance Rating</div>
              <div style="text-align:center; padding:10px 0;">
                <div style="font-size:3.5rem; font-weight:700; color:hsl(var(--primary));">4.2</div>
                <div style="color:var(--warning); font-size:1.25rem;">
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star-half-stroke"></i>
                </div>
                <p style="margin-top:10px; color:var(--text-secondary); font-size:0.875rem;">Review Period: FY 2025-2026</p>
              </div>
            </div>
            <div class="card">
              <div class="card-title">Performance Improvement Plan (PIP)</div>
              <div style="padding:15px; border-radius:10px; background:hsla(var(--success), 0.1); border:1px solid hsla(var(--success), 0.2); display:flex; flex-direction:column; gap:8px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <strong>PIP Status</strong>
                  <span class="badge badge-success">Not Initiated</span>
                </div>
                <p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.4;">No performance plans are currently active. Keep up the high standards!</p>
              </div>
            </div>
          </div>

          <div class="dashboard-layout">
            <div>
              <div class="card">
                <div class="card-title">Submit Self-Assessment feedback</div>
                <form onsubmit="event.preventDefault(); showToast('Self assessment submitted.', 'success');">
                  <div class="form-group">
                    <label>Assessment Subject</label>
                    <input type="text" class="form-control" placeholder="Mid-year Review" required>
                  </div>
                  <div class="form-group">
                    <label>Rating (Self Evaluation)</label>
                    <input type="range" min="1" max="5" class="form-control" style="padding:0;">
                  </div>
                  <div class="form-group">
                    <label>Comments / Rationale</label>
                    <textarea class="form-control" style="height:80px;" required></textarea>
                  </div>
                  <button class="btn btn-primary">Submit Feedback</button>
                </form>
              </div>
            </div>
            <div>
              <div class="card" style="background:linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%); color:#fff; border:none;">
                <div class="card-title" style="color:#fff;">AI Skill Suggestions</div>
                <div style="display:flex; flex-direction:column; gap:12px; font-size:0.85rem; color:#e2e8f0;">
                  <div>🚀 Improve TypeScript proficiency via targeted exercises.</div>
                  <div>🎯 Attend peer leadership coding workshops.</div>
                  <div>💻 Enhance code review response latency metrics.</div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- EMP: Learning & Dev -->
        <section id="emp-mod-emp-learning" class="emp-module" style="display:none;">
          <div class="card">
            <div class="card-title">Learning Progress</div>
            <div class="chart-container">
              <canvas id="empLearningLine"></canvas>
            </div>
          </div>
          
          <h3 style="margin-bottom:16px;">Assigned Training Courses</h3>
          <div class="emp-grid" id="emp-training-grid"></div>

          <div class="card">
            <div class="card-title">Attended Training Programs</div>
