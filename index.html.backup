                </thead>
                <tbody id="emp-attended-training-tbody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- EMP: Tasks -->
        <section id="emp-mod-emp-tasks" class="emp-module" style="display:none;">
          <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
            <button class="btn btn-primary" onclick="openModal('add-task-modal')"><i class="fa-solid fa-plus"></i> Add New Task</button>
          </div>
          
          <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-bottom:24px;">
            <div class="card">
              <div class="card-title" style="font-size:0.95rem; border-bottom:2px solid hsl(var(--info)); padding-bottom:8px;">To Do</div>
              <div style="display:flex; flex-direction:column; gap:10px; min-height:200px;" id="task-col-todo" ondragover="allowDrop(event)" ondrop="dropTask(event, 'todo')"></div>
            </div>
            <div class="card">
              <div class="card-title" style="font-size:0.95rem; border-bottom:2px solid hsl(var(--warning)); padding-bottom:8px;">In Progress</div>
              <div style="display:flex; flex-direction:column; gap:10px; min-height:200px;" id="task-col-inprogress" ondragover="allowDrop(event)" ondrop="dropTask(event, 'in-progress')"></div>
            </div>
            <div class="card">
              <div class="card-title" style="font-size:0.95rem; border-bottom:2px solid hsl(var(--success)); padding-bottom:8px;">Done</div>
              <div style="display:flex; flex-direction:column; gap:10px; min-height:200px;" id="task-col-done" ondragover="allowDrop(event)" ondrop="dropTask(event, 'done')"></div>
            </div>
          </div>

          <div class="dashboard-layout">
            <div>
              <div class="card">
                <div class="card-title">Daily Work Report</div>
                <form onsubmit="handleDailyWorkReport(event)">
                  <div class="form-group">
                    <label>What did you work on today?</label>
                    <textarea class="form-control" id="daily-report-text" style="height:90px;" required></textarea>
                  </div>
                  <button type="submit" class="btn btn-primary">Submit Report</button>
                </form>
              </div>
            </div>
            <div>
              <div class="card">
                <div class="card-title">Task Deadline Tracker</div>
                <div class="table-responsive">
                  <table class="custom-table" style="font-size:0.8rem;">
                    <thead>
                      <tr>
                        <th>Task</th>
                        <th>Days Left</th>
                      </tr>
                    </thead>
                    <tbody id="emp-deadlines-tbody"></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- EMP: Meetings -->
        <section id="emp-mod-emp-meetings" class="emp-module" style="display:none;">
          <div class="card">
            <div class="card-title">Upcoming Schedule</div>
