      });
      if (leavesList === '') leavesList = 'No leave logs found.';

      document.getElementById('ledger-content').innerHTML = `
        <div style="display:flex; align-items:center; gap:20px; margin-bottom:20px;">
          <img src="${emp.avatar}" style="width:60px; height:60px; border-radius:50%; object-fit:cover;">
          <div>
            <h3>${emp.name}</h3>
            <p>${emp.role} | Department: ${emp.dept}</p>
            <p style="font-size:0.8rem; color:var(--text-secondary);">Emp ID: ${emp.id}</p>
          </div>
        </div>
        
        <h4 style="margin-bottom:10px;">Recent Attendance Timesheet Logs</h4>
        <div class="table-responsive" style="margin-bottom:20px;">
          <table class="custom-table" style="font-size:0.8rem;">
            <thead>
              <tr>
                <th>Date</th>
                <th>Clock In</th>
                <th>Clock Out</th>
                <th>Hours</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              ${appState.timesheet.map(t => `
                <tr>
                  <td>${t.date}</td>
                  <td>${t.clockIn}</td>
                  <td>${t.clockOut}</td>
                  <td>${t.hours}</td>
                  <td><span class="badge ${t.status === 'Punctual' ? 'badge-success' : 'badge-warning'}">${t.status}</span></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>

        <h4 style="margin-bottom:10px;">Leave History</h4>
        <ul style="margin-left:20px; font-size:0.875rem; margin-bottom:20px;">
          ${leavesList}
        </ul>

        <h4 style="margin-bottom:10px;">Payroll Summary</h4>
        <div style="padding:12px; background:hsl(var(--bg-main)); border-radius:8px; display:flex; justify-content:space-between; font-size:0.875rem;">
          <span>Gross Basic: <strong>₹85,000</strong></span>
          <span>Deductions: <strong>₹12,750</strong></span>
          <span>Net Salary Dispense: <strong>₹72,250</strong></span>
        </div>
      `;
      openModal('ledger-modal');
    }

    // Timer logic on HR Attendance
    let timeSeconds = 0;
    function toggleClockInOut() {
      if (!appState.clockRunning) {
        // Clock In
        appState.clockRunning = true;
        appState.clockInTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        document.getElementById('btn-clockin').disabled = true;
        document.getElementById('btn-clockout').disabled = false;
        document.getElementById('label-clockin').innerText = `Login: ${appState.clockInTime}`;
        document.getElementById('label-shift-status').className = 'badge badge-success';
        document.getElementById('label-shift-status').innerText = 'Active Shift';
        
        appState.clockInterval = setInterval(() => {
          timeSeconds++;
          const hrs = String(Math.floor(timeSeconds / 3600)).padStart(2, '0');
          const mins = String(Math.floor((timeSeconds % 3600) / 60)).padStart(2, '0');
          const secs = String(timeSeconds % 60).padStart(2, '0');
          document.getElementById('hr-stopwatch').innerText = `${hrs}:${mins}:${secs}`;
          // Also set the live employee attendance hours
          const empLive = document.getElementById('emp-live-hours');
          if (empLive) empLive.innerText = `${hrs}:${mins} Hrs`;
        }, 1000);
        
        showToast('Clocked In successfully.', 'success');
      } else {
        // Clock Out
        appState.clockRunning = false;
        clearInterval(appState.clockInterval);
        appState.clockOutTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        document.getElementById('btn-clockin').disabled = false;
        document.getElementById('btn-clockout').disabled = true;
        document.getElementById('label-clockout').innerText = `Logout: ${appState.clockOutTime}`;
        document.getElementById('label-shift-status').className = 'badge badge-danger';
        document.getElementById('label-shift-status').innerText = 'Logged Out';
        
        // Save to Timesheet
        const hrsWorked = (timeSeconds / 3600).toFixed(2);
        appState.timesheet.unshift({
          date: new Date().toISOString().split('T')[0],
          clockIn: appState.clockInTime,
          clockOut: appState.clockOutTime,
          hours: parseFloat(hrsWorked),
          status: hrsWorked >= 8 ? 'Punctual' : 'Early Out'
        });
        
        timeSeconds = 0;
        document.getElementById('hr-stopwatch').innerText = '00:00:00';
        showToast('Clocked Out successfully.', 'info');
        renderHRAttendance();
      }
    }

    function handleLeaveFormSubmit(e) {
      e.preventDefault();
      const type = document.getElementById('hr-leave-type').value;
      const start = document.getElementById('hr-leave-from').value;
      const end = document.getElementById('hr-leave-to').value;
      const reason = document.getElementById('hr-leave-reason').value;
      
      appState.leaves.push({
        id: appState.leaves.length + 1,
        empId: 'EMP-1023', // Admin pre-fill
        empName: 'Venkat Raman',
        type, start, end, reason, status: 'Pending'
      });
      showToast('Leave request submitted.', 'success');
      document.getElementById('hr-leave-form').reset();
      renderHRAttendance();
    }

    function renderHRAttendance() {
      // Approvals
      const tbody = document.getElementById('hr-leave-approvals-tbody');
      tbody.innerHTML = '';
      appState.leaves.forEach(l => {
        tbody.innerHTML += `
          <tr>
            <td><strong>${l.empName}</strong></td>
            <td>${l.type}</td>
            <td>${l.start} to ${l.end}</td>
            <td><span class="badge ${l.status === 'Approved' ? 'badge-success' : l.status === 'Rejected' ? 'badge-danger' : 'badge-warning'}">${l.status}</span></td>
            <td>
              ${l.status === 'Pending' ? `
                <div style="display:flex; gap:4px;">
                  <button class="btn btn-primary" style="padding:4px 8px; font-size:0.7rem;" onclick="approveLeave(${l.id})">Approve</button>
                  <button class="btn btn-danger" style="padding:4px 8px; font-size:0.7rem;" onclick="rejectLeave(${l.id})">Reject</button>
                </div>
              ` : '--'}
            </td>
          </tr>
        `;
      });

      // Shift ledger
      const ledgerTbody = document.getElementById('hr-shift-ledger-tbody');
      ledgerTbody.innerHTML = '';
      appState.timesheet.forEach(t => {
        ledgerTbody.innerHTML += `
          <tr>
            <td>${t.date}</td>
            <td>${t.clockIn}</td>
            <td>${t.clockOut}</td>
            <td>${t.hours} Hrs</td>
            <td><span class="badge ${t.status === 'Punctual' ? 'badge-success' : 'badge-warning'}">${t.status}</span></td>
          </tr>
        `;
      });

      // Weekly grid (7 days)
      const weeklyTbody = document.getElementById('hr-weekly-report-tbody');
      weeklyTbody.innerHTML = '';
      appState.employees.forEach(emp => {
        weeklyTbody.innerHTML += `
          <tr>
            <td><strong>${emp.name}</strong></td>
            <td><span class="badge badge-success">P</span></td>
            <td><span class="badge badge-success">P</span></td>
            <td><span class="badge badge-success">P</span></td>
            <td><span class="badge badge-success">P</span></td>
            <td><span class="badge badge-success">P</span></td>
            <td><span class="badge badge-danger">A</span></td>
            <td><span class="badge badge-info">H</span></td>
          </tr>
        `;
      });

      // Monthly grid layout
      const monthlyTable = document.getElementById('hr-monthly-report-table');
      let headerCells = '<th>Employee</th>';
      for(let d=1; d<=30; d++) headerCells += `<th>${d}</th>`;
      
      let rowsHtml = '';
      appState.employees.forEach(emp => {
        let cells = `<td><strong>${emp.name}</strong></td>`;
        for(let d=1; d<=30; d++) {
          let color = '#10b981'; // Green (Present)
          let char = 'P';
          if (d % 7 === 0 || d % 7 === 6) { color = '#94a3b8'; char = 'W'; } // Weekend
          else if (d === 15) { color = '#f59e0b'; char = 'L'; } // Leave
          else if (d === 22) { color = '#f4637e'; char = 'A'; } // Absent
          
          cells += `<td style="background:${color}; color:#white; color: #fff; text-align:center; font-weight:700;">${char}</td>`;
        }
        rowsHtml += `<tr>${cells}</tr>`;
      });
      monthlyTable.innerHTML = `<thead><tr>${headerCells}</tr></thead><tbody>${rowsHtml}</tbody>`;
    }

