    let charts = {};

    // Toast Messages
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = `toast ${type}`;
      let icon = 'fa-info-circle';
      if (type === 'success') icon = 'fa-circle-check';
      if (type === 'error') icon = 'fa-circle-exclamation';
      if (type === 'warning') icon = 'fa-triangle-exclamation';
      
      toast.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${message}</span>`;
      container.appendChild(toast);
      setTimeout(() => toast.classList.add('active'), 10);
      setTimeout(() => {
        toast.classList.remove('active');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Modal Control
    function openModal(id) {
      document.getElementById(id).classList.add('active');
    }
    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    // Collapsible sidebar
    function toggleSidebar(portal) {
      const sb = document.getElementById(`${portal}-sidebar`);
      const icon = document.getElementById(`${portal}-chevron`);
      sb.classList.toggle('collapsed');
      if (sb.classList.contains('collapsed')) {
        icon.className = 'fa-solid fa-chevron-right';
      } else {
        icon.className = 'fa-solid fa-chevron-left';
      }
    }
    function toggleMobileSidebar(portal) {
      document.getElementById(`${portal}-sidebar`).classList.toggle('active');
      document.querySelector('.app-layout').classList.toggle('mobile-active');
    }

    // Dropdowns
    function toggleDropdown(id) {
      const menu = document.getElementById(id);
      menu.classList.toggle('active');
    }
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.user-dropdown-btn')) {
        document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.remove('active'));
      }
    });

    // Switch Role on Login
    let currentSelectedRole = 'hr';
    function switchLoginRole(role) {
      currentSelectedRole = role;
      document.getElementById('btn-toggle-hr').classList.toggle('active', role === 'hr');
      document.getElementById('btn-toggle-emp').classList.toggle('active', role === 'employee');
      
      const email = document.getElementById('login-email');
      const pass = document.getElementById('login-password');
      const subtitle = document.getElementById('login-role-subtitle');
      
      if (role === 'hr') {
        subtitle.innerText = 'HR Director Access';
        email.value = 'hr@company.com';
        pass.value = 'admin123';
      } else {
        subtitle.innerText = 'Employee Self-Service';
        email.value = 'emp@company.com';
        pass.value = 'emp123';
      }
    }

    // Handle Login Submit
    function handleLoginSubmit(event) {
      event.preventDefault();
      appState.currentPortal = currentSelectedRole;
      document.getElementById('login-container').style.display = 'none';
      
      if (currentSelectedRole === 'hr') {
        document.getElementById('hr-app').style.display = 'flex';
        switchHRModule('dashboard');
        showToast('HR Portal Authenticated.', 'success');
      } else {
        document.getElementById('emp-app').style.display = 'flex';
        switchEmpModule('emp-dashboard');
        showToast('Employee Self-Service Authenticated.', 'success');
        // Auto trigger popup
        showNotificationPopup();
      }
    }

    // Handle Logout
    function handleLogout() {
      appState.currentPortal = null;
      document.getElementById('hr-app').style.display = 'none';
      document.getElementById('emp-app').style.display = 'none';
      document.getElementById('login-container').style.display = 'grid';
      showToast('Logged out securely.', 'info');
    }

    // Theme Toggle
    function toggleDarkMode() {
      document.body.classList.toggle('dark-mode');
      showToast('Theme configuration updated.', 'info');
      // Redraw charts for appropriate visibility
      if (appState.currentPortal === 'hr') initHRCharts();
      else initEmpCharts();
    }

    // Navigation Switchers
    function switchHRModule(mod, element = null) {
      appState.hrCurrentModule = mod;
      document.querySelectorAll('.hr-module').forEach(m => m.style.display = 'none');
      document.getElementById(`hr-mod-${mod}`).style.display = 'block';
      
      // Sidebar active styles
      document.querySelectorAll('#hr-sidebar .nav-item').forEach(i => i.classList.remove('active'));
      if (element) element.classList.add('active');
      
      document.getElementById('hr-page-title').innerText = mod.replace('-', ' ').toUpperCase();
      
      // Init module features
      if (mod === 'dashboard') {
        initHRCharts();
        renderHRDashboard();
      } else if (mod === 'employee-management') {
        renderEmployeeDirectory();
      } else if (mod === 'attendance-leave') {
        renderHRAttendance();
      } else if (mod === 'payroll-management') {
        renderHRPayroll();
      } else if (mod === 'recruitment-ats') {
        renderATSBoard();
      } else if (mod === 'notification-system') {
        renderHRNotificationCenter();
      }
    }

    function switchEmpModule(mod, element = null) {
      appState.empCurrentModule = mod;
      document.querySelectorAll('.emp-module').forEach(m => m.style.display = 'none');
      document.getElementById(`emp-mod-${mod}`).style.display = 'block';
      
      document.querySelectorAll('#emp-sidebar .nav-item').forEach(i => i.classList.remove('active'));
      if (element) element.classList.add('active');
      
      document.getElementById('emp-page-title').innerText = mod.replace('emp-', '').replace('-', ' ').toUpperCase();
      
      if (mod === 'emp-dashboard') {
        initEmpCharts();
        renderEmpDashboard();
      } else if (mod === 'emp-profile') {
        renderEmpProfile();
      } else if (mod === 'emp-documents') {
        renderEmpDocuments();
      } else if (mod === 'emp-attendance') {
        switchEmpAttTab('overview');
      } else if (mod === 'emp-payroll') {
        renderEmpPayroll();
      } else if (mod === 'emp-learning') {
        renderEmpLearning();
      } else if (mod === 'emp-tasks') {
        renderEmpTasks();
      } else if (mod === 'emp-meetings') {
        renderEmpMeetings();
      } else if (mod === 'emp-notifications') {
        renderEmpNotifications();
      } else if (mod === 'emp-helpdesk') {
        renderEmpHelpdesk();
      } else if (mod === 'emp-policies') {
        renderEmpPolicies();
      }
    }

    // Toggle Collapsible card (ATS Rejected list)
    function toggleCollapsibleCard(id) {
      const cardEl = document.getElementById(id);
      cardEl.style.display = (cardEl.style.display === 'none') ? 'block' : 'none';
    }

    // --- CHART INITIALIZATIONS ---
    function initHRCharts() {
      const textColor = getComputedStyle(document.body).getPropertyValue('--text-primary').trim();
      const gridColor = getComputedStyle(document.body).getPropertyValue('--border').trim();
      
      const ctxLine = document.getElementById('hrAttendanceTrends')?.getContext('2d');
      if (ctxLine) {
        if (charts.hrAttendanceLine) charts.hrAttendanceLine.destroy();
        charts.hrAttendanceLine = new Chart(ctxLine, {
          type: 'line',
          data: {
            labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
            datasets: [{
              label: 'Attendance Rate %',
              data: [92, 94, 91, 95, 96, 94, 95, 93, 94, 75],
              borderColor: 'hsl(230, 80%, 55%)',
              backgroundColor: 'rgba(99, 102, 241, 0.1)',
              fill: true,
              tension: 0.3
            }]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });
      }

      const ctxBar = document.getElementById('hrAttendanceByDay')?.getContext('2d');
      if (ctxBar) {
        if (charts.hrAttendanceBar) charts.hrAttendanceBar.destroy();
        charts.hrAttendanceBar = new Chart(ctxBar, {
          type: 'bar',
          data: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
            datasets: [
              { label: 'Present', data: [22, 21, 23, 22, 20, 15], backgroundColor: 'rgba(16, 185, 129, 0.85)' },
              { label: 'Absent', data: [2, 3, 1, 2, 4, 9], backgroundColor: 'rgba(244, 63, 94, 0.85)' }
            ]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }

      const ctxDonut = document.getElementById('hrDeptDonut')?.getContext('2d');
      if (ctxDonut) {
        if (charts.hrDeptDonut) charts.hrDeptDonut.destroy();
        charts.hrDeptDonut = new Chart(ctxDonut, {
          type: 'doughnut',
          data: {
            labels: ['Engineering', 'Human Resources', 'Finance', 'Design', 'Marketing'],
            datasets: [{
              data: [2, 1, 1, 1, 1],
              backgroundColor: ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#06b6d4']
            }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }

      const ctxPay = document.getElementById('hrPayrollBar')?.getContext('2d');
      if (ctxPay) {
        if (charts.hrPayrollBar) charts.hrPayrollBar.destroy();
        charts.hrPayrollBar = new Chart(ctxPay, {
          type: 'bar',
          data: {
            labels: ['Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May'],
            datasets: [{
              label: 'Payroll Spent (₹)',
              data: [420000, 450000, 450000, 480000, 490000, 510000],
              backgroundColor: 'rgba(99, 102, 241, 0.8)'
            }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }
    }

    function initEmpCharts() {
      const ctxDonut = document.getElementById('empAttendanceDonut')?.getContext('2d');
      if (ctxDonut) {
        if (charts.empAttendanceDonut) charts.empAttendanceDonut.destroy();
        charts.empAttendanceDonut = new Chart(ctxDonut, {
          type: 'doughnut',
          data: {
            labels: ['Present', 'Absent', 'Leave'],
            datasets: [{
              data: [22, 1, 1],
              backgroundColor: ['#10b981', '#f4637e', '#f59e0b']
            }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }

      const ctxLine = document.getElementById('empHoursLine')?.getContext('2d');
      if (ctxLine) {
        if (charts.empHoursLine) charts.empHoursLine.destroy();
        charts.empHoursLine = new Chart(ctxLine, {
          type: 'line',
          data: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
            datasets: [{
              label: 'Working Hours',
              data: [9.0, 8.8, 9.1, 8.9, 8.8, 0, 0],
              borderColor: 'hsl(230, 80%, 55%)',
              tension: 0.2,
              fill: true,
              backgroundColor: 'rgba(99, 102, 241, 0.05)'
            }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }
    }

    // --- HR VIEW CONTROLLER LOGIC ---

    function renderHRDashboard() {
      const totalEmp = appState.employees.length;
      const presentToday = appState.employees.filter(e => e.status === 'Approved').length - 1; // Sample present count logic
      const pendingLeaves = appState.leaves.filter(l => l.status === 'Pending').length;
      
      document.getElementById('hr-dash-total-emp').innerText = totalEmp;
      document.getElementById('hr-dash-present').innerText = presentToday;
      document.getElementById('hr-dash-total-head').innerText = totalEmp;
      document.getElementById('hr-dash-leaves').innerText = pendingLeaves;

      // Render Dynamic Actions
      const actionsList = document.getElementById('hr-dash-actions');
      actionsList.innerHTML = '';
      appState.leaves.filter(l => l.status === 'Pending').forEach(l => {
        actionsList.innerHTML += `
          <div style="padding:10px; background:hsl(var(--bg-main)); border-radius:8px; display:flex; justify-content:space-between; align-items:center;">
            <div>
              <strong>Approve Leave for ${l.empName}</strong>
              <div style="color:var(--text-secondary); font-size:0.75rem;">Type: ${l.type} | Date: ${l.start}</div>
            </div>
            <button class="btn btn-primary" style="padding:6px 12px; font-size:0.75rem;" onclick="switchHRModule('attendance-leave')">Review</button>
          </div>
        `;
      });
      if (actionsList.innerHTML === '') {
        actionsList.innerHTML = '<div style="color:var(--text-secondary);">No immediate action items.</div>';
      }
    }

    function renderEmployeeDirectory() {
      renderEmployeeGrid();
      renderEmployeeTable();
    }

    function renderEmployeeGrid() {
      const grid = document.getElementById('employee-grid');
      grid.innerHTML = '';
      appState.employees.forEach(emp => {
        grid.innerHTML += `
          <div class="emp-card">
            <img src="${emp.avatar}" alt="${emp.name}">
            <div class="emp-card-name">${emp.name}</div>
            <div class="emp-card-role">${emp.role}</div>
            <div class="emp-card-badges">
              <span class="badge badge-primary">${emp.dept}</span>
              <span class="badge ${emp.status === 'Approved' ? 'badge-success' : emp.status === 'Rejected' ? 'badge-danger' : 'badge-warning'}">${emp.status}</span>
            </div>
            <button class="btn btn-secondary" style="width:100%; margin-top:8px;" onclick="openLedgerModal('${emp.id}')">View Ledger</button>
            <div class="emp-card-actions">
              <button class="btn btn-secondary" style="padding: 6px 10px;" onclick="openEditEmployeeModal('${emp.id}')"><i class="fa-solid fa-pen"></i></button>
              <button class="btn btn-secondary" style="padding: 6px 10px; color:hsl(var(--danger));" onclick="deleteEmployee('${emp.id}')"><i class="fa-solid fa-trash"></i></button>
            </div>
          </div>
        `;
      });
    }

    function renderEmployeeTable() {
      const tbody = document.getElementById('employee-roster-tbody');
      tbody.innerHTML = '';
      appState.employees.forEach(emp => {
        tbody.innerHTML += `
          <tr>
            <td>
              <div style="display:flex; align-items:center; gap:10px;">
                <img src="${emp.avatar}" style="width:30px; height:30px; border-radius:50%; object-fit:cover;">
                <div>
                  <strong>${emp.name}</strong>
                  <div style="font-size:0.75rem; color:var(--text-secondary);">${emp.id}</div>
                </div>
              </div>
            </td>
            <td>${emp.dept}</td>
            <td>${emp.role}</td>
            <td>${emp.email}</td>
            <td>${emp.joined}</td>
            <td><span class="badge ${emp.status === 'Approved' ? 'badge-success' : emp.status === 'Rejected' ? 'badge-danger' : 'badge-warning'}">${emp.status}</span></td>
            <td>
              <div style="display:flex; gap:6px;">
                <button class="btn btn-secondary" style="padding:6px 10px; font-size:0.75rem;" onclick="approveEmployeeStatus('${emp.id}')">Approve</button>
                <button class="btn btn-secondary" style="padding:6px 10px; font-size:0.75rem; color:hsl(var(--danger));" onclick="rejectEmployeeStatus('${emp.id}')">Reject</button>
              </div>
            </td>
          </tr>
        `;
      });
    }

    function filterEmployeeGrid() {
      const search = document.getElementById('emp-search').value.toLowerCase();
      const dept = document.getElementById('emp-dept-filter').value;
      const cards = document.querySelectorAll('.emp-card');
      
      cards.forEach((card, index) => {
        const emp = appState.employees[index];
        if (!emp) return;
        const matchesSearch = emp.name.toLowerCase().includes(search) || emp.role.toLowerCase().includes(search);
        const matchesDept = (dept === 'All' || emp.dept === dept);
        card.style.display = (matchesSearch && matchesDept) ? 'block' : 'none';
      });
    }

    // CRUD - Employee
    function openAddEmployeeModal() {
      document.getElementById('emp-modal-title').innerText = 'Add Employee';
      document.getElementById('edit-emp-id').value = '';
      document.getElementById('add-employee-form').reset();
      openModal('add-employee-modal');
    }

    function openEditEmployeeModal(id) {
      const emp = appState.employees.find(e => e.id === id);
      if (!emp) return;
      document.getElementById('emp-modal-title').innerText = 'Edit Employee';
      document.getElementById('edit-emp-id').value = emp.id;
      document.getElementById('new-emp-name').value = emp.name;
      document.getElementById('new-emp-email').value = emp.email;
      document.getElementById('new-emp-dept').value = emp.dept;
      document.getElementById('new-emp-role').value = emp.role;
      document.getElementById('new-emp-aadhaar').value = emp.aadhaar;
      document.getElementById('new-emp-joining').value = emp.joined;
      openModal('add-employee-modal');
    }

    function handleEmployeeFormSubmit(e) {
      e.preventDefault();
      const editId = document.getElementById('edit-emp-id').value;
      const name = document.getElementById('new-emp-name').value;
      const email = document.getElementById('new-emp-email').value;
      const dept = document.getElementById('new-emp-dept').value;
      const role = document.getElementById('new-emp-role').value;
      const aadhaar = document.getElementById('new-emp-aadhaar').value;
      const joined = document.getElementById('new-emp-joining').value;
      
      if (editId) {
        // Edit mode
        const emp = appState.employees.find(e => e.id === editId);
        if (emp) {
          emp.name = name;
          emp.email = email;
          emp.dept = dept;
          emp.role = role;
          emp.aadhaar = aadhaar;
          emp.joined = joined;
          showToast('Employee details updated.', 'success');
        }
      } else {
        // Add mode
        const newId = `EMP-${Math.floor(1000 + Math.random() * 9000)}`;
        appState.employees.push({
          id: newId, name, email, dept, role, joined, status: 'Pending',
          avatar: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150',
          aadhaar, phone: '+91 98765 00000',
          address: { door: 'N/A', street: 'N/A', city: 'N/A', state: 'N/A', pin: '000000' },
          emergency: { name: 'N/A', relation: 'N/A', phone: 'N/A' },
          blood: 'O+', dob: '1990-01-01', gender: 'Male'
        });
        showToast('New employee registered.', 'success');
      }
      closeModal('add-employee-modal');
      renderEmployeeDirectory();
    }

    function deleteEmployee(id) {
      if (confirm('Are you sure you want to delete this employee?')) {
        appState.employees = appState.employees.filter(e => e.id !== id);
        showToast('Employee deleted.', 'error');
        renderEmployeeDirectory();
      }
    }

    function approveEmployeeStatus(id) {
      const emp = appState.employees.find(e => e.id === id);
      if (emp) {
        emp.status = 'Approved';
        showToast(`Employee status approved for ${emp.name}`, 'success');
        renderEmployeeDirectory();
      }
    }

    function rejectEmployeeStatus(id) {
      const emp = appState.employees.find(e => e.id === id);
      if (emp) {
        emp.status = 'Rejected';
        showToast(`Employee status rejected for ${emp.name}`, 'danger');
        renderEmployeeDirectory();
      }
    }

    // Ledger Modal View
