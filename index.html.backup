                <div class="form-group">
                  <label>Priority</label>
                  <div style="display:flex; gap:12px;">
                    <label><input type="radio" name="tkt-priority" value="Low" checked> Low</label>
                    <label><input type="radio" name="tkt-priority" value="Medium"> Medium</label>
                    <label><input type="radio" name="tkt-priority" value="High"> High</label>
                  </div>
                </div>
                <div class="form-group">
                  <label>Description</label>
                  <textarea id="tkt-desc" class="form-control" style="height:80px;" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Submit Ticket</button>
