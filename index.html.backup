    function toggleAadhaarMask() {
      viewMaskedAadhaar = !viewMaskedAadhaar;
      renderEmpProfile();
    }

    function makeProfileEditable() {
      isProfileEditing = true;
      renderEmpProfile();
      showToast('Personal fields are now editable.', 'info');
    }

    // Documents
    function renderEmpDocuments() {
      const grid = document.getElementById('emp-documents-grid');
      const docs = [
        { name: 'Offer Letter', status: 'Available', icon: 'fa-file-contract', color: 'success' },
        { name: 'Appointment Letter', status: 'Available', icon: 'fa-file-signature', color: 'success' },
        { name: 'Experience Letters', status: 'Available', icon: 'fa-file-circle-check', color: 'success' },
        { name: 'Salary Slips', status: 'Available', icon: 'fa-file-invoice-dollar', color: 'success', payslips: true },
        { name: 'Tax Documents', status: 'Pending', icon: 'fa-receipt', color: 'warning' },
        { name: 'ID Proof — Aadhaar Card', status: 'Available', icon: 'fa-id-card', color: 'success' },
        { name: 'PAN Card', status: 'Available', icon: 'fa-credit-card', color: 'success' },
        { name: 'Driving License', status: 'Upload Required', icon: 'fa-car', color: 'warning', upload: true },
        { name: 'Previous Company Relieving Letter', status: 'Upload Required', icon: 'fa-briefcase', color: 'warning', upload: true },
        { name: 'Certifications Log', status: 'Available', icon: 'fa-certificate', color: 'success' }
      ];

      grid.innerHTML = '';
      docs.forEach((d, idx) => {
        let actionBtn = `<button class="btn btn-secondary" style="width:100%; margin-top:12px;" onclick="showToast('Downloading document...','info')">Download</button>`;
        if (d.upload) {
          actionBtn = `<input type="file" id="upload-${idx}" style="display:none;" onchange="showToast('Document uploaded successfully.', 'success')">
                       <button class="btn btn-primary" style="width:100%; margin-top:12px;" onclick="document.getElementById('upload-${idx}').click()">Upload File</button>`;
        }
        if (d.payslips) {
          actionBtn = `<button class="btn btn-secondary" style="width:100%; margin-top:12px;" onclick="switchEmpModule('emp-payroll')">View Payslips</button>`;
        }

        grid.innerHTML += `
          <div class="emp-card" style="text-align:left;">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
              <div class="metric-icon-box" style="background:hsla(var(--primary), 0.1); color:hsl(var(--primary)); width:40px; height:40px;"><i class="fa-solid ${d.icon}"></i></div>
              <div>
                <strong>${d.name}</strong>
                <p style="font-size:0.75rem; color:var(--text-secondary);">${d.status}</p>
              </div>
            </div>
            ${actionBtn}
          </div>
        `;
      });
    }

    // Employee Attendance Tabs
    let empAttTab = 'overview';
    function switchEmpAttTab(tab) {
      empAttTab = tab;
      document.querySelectorAll('#emp-mod-emp-attendance [id^="emp-att-tab-"]').forEach(btn => {
        btn.className = btn.id === `emp-att-tab-${tab}` ? 'btn btn-primary' : 'btn btn-secondary';
      });
      document.getElementById('emp-att-sect-overview').style.display = tab === 'overview' ? 'block' : 'none';
      document.getElementById('emp-att-sect-apply').style.display = tab === 'apply' ? 'block' : 'none';
      document.getElementById('emp-att-sect-history').style.display = tab === 'history' ? 'block' : 'none';
      document.getElementById('emp-att-sect-timesheet').style.display = tab === 'timesheet' ? 'block' : 'none';
      document.getElementById('emp-att-sect-analysis').style.display = tab === 'analysis' ? 'block' : 'none';

      if (tab === 'overview') {
        renderEmpOverview();
      } else if (tab === 'history') {
        renderEmpLeaveHistory();
      } else if (tab === 'timesheet') {
        renderEmpTimesheet();
      } else if (tab === 'analysis') {
        renderEmpAnalysis();
      }
    }

    function renderEmpOverview() {
      // Mini calendar
      const cal = document.getElementById('emp-attendance-calendar');
      cal.innerHTML = '';
      
      const weekdays = ['M','T','W','T','F','S','S'];
      weekdays.forEach(w => cal.innerHTML += `<div style="color:var(--text-secondary); font-size:0.8rem; padding:4px;">${w}</div>`);
      
      for(let day=1; day<=30; day++) {
        let borderStyle = '';
        let bgColor = '';
        let color = '';
        if (day === 8) { borderStyle = 'border: 2px solid hsl(var(--primary));'; }
        if (day % 7 === 0 || day % 7 === 6) { bgColor = 'background:hsl(var(--border));'; }
        else if (day < 8) { bgColor = 'background:hsla(var(--success), 0.15); color:hsl(var(--success));'; } // Present
        
        cal.innerHTML += `<div style="padding:8px; border-radius:50%; font-size:0.85rem; ${bgColor} ${borderStyle} ${color}">${day}</div>`;
      }

      // Holidays
      const holList = document.getElementById('emp-holidays-list');
      const holidays = [
        { name: 'Republic Day', date: '26 Jan 2026' },
        { name: 'Good Friday', date: '18 Apr 2026' },
        { name: 'Labour Day', date: '01 May 2026' },
        { name: 'Independence Day', date: '15 Aug 2026' },
        { name: 'Gandhi Jayanti', date: '02 Oct 2026' }
      ];
      holList.innerHTML = holidays.map(h => `
        <div style="display:flex; justify-content:space-between; font-size:0.875rem; border-bottom:1px solid hsl(var(--border)); padding-bottom:8px;">
          <span>${h.name}</span><strong style="color:hsl(var(--primary));">${h.date}</strong>
        </div>
      `).join('');
    }

    function handleEmpLeaveForm(e) {
      e.preventDefault();
      const type = document.getElementById('emp-leave-type').value;
      const start = document.getElementById('emp-leave-from').value;
      const end = document.getElementById('emp-leave-to').value;
      const reason = document.getElementById('emp-leave-reason').value;

      appState.leaves.push({
        id: appState.leaves.length + 1,
        empId: 'EMP-2047',
        empName: 'Arjun Mehta',
        type, start, end, reason, status: 'Pending'
      });
      showToast('Leave request submitted successfully.', 'success');
      document.getElementById('emp-leave-form').reset();
      switchEmpAttTab('history');
    }

    function renderEmpLeaveHistory() {
      const tbody = document.getElementById('emp-leave-history-tbody');
      tbody.innerHTML = '';
      appState.leaves.filter(l => l.empId === 'EMP-2047').forEach(l => {
        tbody.innerHTML += `
          <tr>
            <td>${l.start} to ${l.end}</td>
            <td>${l.type}</td>
            <td>4 Days</td>
            <td>${l.reason}</td>
            <td><span class="badge ${l.status === 'Approved' ? 'badge-success' : 'badge-warning'}">${l.status}</span></td>
            <td>
              ${l.status === 'Pending' ? `<button class="btn btn-danger" style="padding:4px 8px; font-size:0.75rem;" onclick="cancelLeave(${l.id})">Cancel</button>` : '--'}
            </td>
          </tr>
        `;
      });
    }

    function cancelLeave(id) {
      appState.leaves = appState.leaves.filter(l => l.id !== id);
      showToast('Leave request cancelled.', 'info');
      renderEmpLeaveHistory();
    }

    function renderEmpTimesheet() {
      const tbody = document.getElementById('emp-timesheet-tbody');
      tbody.innerHTML = '';
      appState.timesheet.forEach(t => {
        tbody.innerHTML += `
          <tr>
            <td>${t.date}</td>
            <td>${t.clockIn}</td>
            <td>${t.clockOut}</td>
            <td>${t.hours} Hrs</td>
            <td><span class="badge ${t.status === 'Punctual' ? 'badge-success' : 'badge-warning'}">${t.status}</span></td>
          </tr>
        `;
      });
    }

    function renderEmpAnalysis() {
      setTimeout(() => {
        const ctx = document.getElementById('empAnalysisBar')?.getContext('2d');
        if (ctx) {
          if (charts.empAnalysisBar) charts.empAnalysisBar.destroy();
          charts.empAnalysisBar = new Chart(ctx, {
            type: 'bar',
            data: {
              labels: ['Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May'],
              datasets: [{
                label: 'Attendance rate %',
                data: [95, 96, 94, 98, 92, 95],
                backgroundColor: 'rgba(99, 102, 241, 0.8)'
              }]
            },
            options: { responsive: true, maintainAspectRatio: false }
          });
        }
      }, 50);
    }

    // Payroll View Arjun
    function renderEmpPayroll() {
      // Monthly table
      const tbody = document.getElementById('emp-payslips-tbody');
      tbody.innerHTML = '';
      const months = ['May 2026', 'April 2026', 'March 2026'];
      months.forEach(m => {
        tbody.innerHTML += `
          <tr>
            <td><strong>${m}</strong></td>
            <td>₹72,250</td>
            <td><button class="btn btn-secondary" style="padding:4px 8px; font-size:0.75rem;" onclick="generateMockPayslipPopup('${m}')">View payslip</button></td>
          </tr>
        `;
      });

      // Deduction Summary Pie
      setTimeout(() => {
        const ctxD = document.getElementById('empDeductionPie')?.getContext('2d');
        if (ctxD) {
          if (charts.empDeductionPie) charts.empDeductionPie.destroy();
          charts.empDeductionPie = new Chart(ctxD, {
            type: 'pie',
            data: {
              labels: ['Provident Fund', 'Professional Tax', 'Income Tax (TDS)'],
              datasets: [{
                data: [7800, 250, 4700],
                backgroundColor: ['#6366f1', '#f59e0b', '#f4637e']
              }]
            },
            options: { responsive: true, maintainAspectRatio: false }
          });
        }

        const ctxE = document.getElementById('empEarningsBar')?.getContext('2d');
        if (ctxE) {
          if (charts.empEarningsBar) charts.empEarningsBar.destroy();
          charts.empEarningsBar = new Chart(ctxE, {
            type: 'bar',
            data: {
              labels: ['Basic', 'HRA', 'Medical'],
              datasets: [{
                label: 'Monthly Breakup',
                data: [65000, 15000, 5000],
                backgroundColor: 'rgba(16, 185, 129, 0.8)'
              }]
            },
            options: { responsive: true, maintainAspectRatio: false }
          });
        }
      }, 50);
    }

    function generateMockPayslipPopup(m) {
      const emp = appState.employees.find(e => e.id === 'EMP-2047');
      selectedPayslipData = { emp, month: m };
      
      const body = document.getElementById('payslip-modal-body');
      body.innerHTML = `
        <div style="border-bottom: 2px solid hsl(var(--primary)); padding-bottom:15px; margin-bottom:15px; display:flex; justify-content:space-between; align-items:center;">
          <div>
            <h2 style="color:hsl(var(--primary)); font-weight:700;">TalentSphere Corp</h2>
            <p style="font-size:0.8rem; color:#64748b;">Bengaluru, India</p>
          </div>
          <div style="text-align:right;">
            <h3>PAYSLIP INVOICE</h3>
            <p style="font-size:0.85rem; font-weight:600;">Cycle: ${m}</p>
          </div>
        </div>
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; font-size:0.875rem;">
          <div>
            <h4 style="border-bottom:1px solid #e2e8f0; padding-bottom:4px; margin-bottom:10px;">Earnings</h4>
            <div style="display:flex; justify-content:space-between; margin-bottom:6px;"><span>Basic</span><strong>₹65,000</strong></div>
            <div style="display:flex; justify-content:space-between; margin-bottom:6px;"><span>HRA</span><strong>₹15,000</strong></div>
            <div style="display:flex; justify-content:space-between; border-top:1px solid #cbd5e1; padding-top:6px; font-weight:700;"><span>Total</span><span>₹80,000</span></div>
          </div>
          <div>
            <h4 style="border-bottom:1px solid #e2e8f0; padding-bottom:4px; margin-bottom:10px;">Deductions</h4>
            <div style="display:flex; justify-content:space-between; margin-bottom:6px;"><span>PF</span><strong>₹7,800</strong></div>
            <div style="display:flex; justify-content:space-between; margin-bottom:6px;"><span>TDS</span><strong>₹4,700</strong></div>
            <div style="display:flex; justify-content:space-between; border-top:1px solid #cbd5e1; padding-top:6px; font-weight:700;"><span>Total</span><span>₹12,500</span></div>
          </div>
        </div>
      `;
      openModal('payslip-modal');
    }

    // Learning
    function renderEmpLearning() {
      const grid = document.getElementById('emp-training-grid');
      grid.innerHTML = '';
      appState.trainings.forEach(tr => {
        grid.innerHTML += `
          <div class="emp-card" style="text-align:left;">
            <span class="badge badge-info" style="margin-bottom:8px;">${tr.category}</span>
            <h4 style="font-size:0.95rem; font-weight:700; margin-bottom:8px;">${tr.name}</h4>
            <p style="font-size:0.8rem; color:var(--text-secondary); margin-bottom:12px;">Assigned by ${tr.assignedBy}</p>
            <div style="display:flex; justify-content:space-between; font-size:0.8rem; margin-bottom:6px;">
              <span>Progress</span><strong>${tr.progress}%</strong>
            </div>
            <div style="height:6px; background:hsl(var(--border)); border-radius:3px; overflow:hidden; margin-bottom:12px;">
              <div style="width:${tr.progress}%; height:100%; background:hsl(var(--primary));"></div>
            </div>
            <button class="btn btn-secondary" style="width:100%;" onclick="showToast('Resuming course material...','info')">Continue Learning</button>
          </div>
        `;
      });

      const tbody = document.getElementById('emp-attended-training-tbody');
      tbody.innerHTML = '';
      appState.attendedTrainings.forEach(at => {
        tbody.innerHTML += `
          <tr>
            <td><strong>${at.name}</strong></td>
            <td>${at.trainer}</td>
            <td>${at.date}</td>
            <td>${at.duration}</td>
            <td>${at.mode}</td>
            <td>
              <span style="color:var(--warning);"><i class="fa-solid fa-star"></i> ${at.rating}/5</span>
              <div style="font-size:0.75rem; color:var(--text-secondary);">${at.review}</div>
            </td>
            <td><span class="badge badge-success">${at.certificate}</span></td>
          </tr>
        `;
      });

      // Draw Chart
      setTimeout(() => {
        const ctx = document.getElementById('empLearningLine')?.getContext('2d');
        if (ctx) {
          if (charts.empLearningLine) charts.empLearningLine.destroy();
          charts.empLearningLine = new Chart(ctx, {
            type: 'line',
            data: {
              labels: ['Wk 1', 'Wk 2', 'Wk 3', 'Wk 4', 'Wk 5', 'Wk 6', 'Wk 7', 'Wk 8'],
              datasets: [{
                label: 'Completed Modules',
                data: [1, 2, 4, 4, 6, 7, 9, 12],
                borderColor: 'hsl(158, 64%, 42%)',
                tension: 0.2
              }]
            },
            options: { responsive: true, maintainAspectRatio: false }
          });
        }
      }, 50);
    }

    // Tasks Board
    function renderEmpTasks() {
      const todo = document.getElementById('task-col-todo');
      const inprog = document.getElementById('task-col-inprogress');
      const done = document.getElementById('task-col-done');

      todo.innerHTML = ''; inprog.innerHTML = ''; done.innerHTML = '';

      appState.tasks.forEach(t => {
        const priorityColor = t.priority === 'High' ? 'badge-danger' : t.priority === 'Medium' ? 'badge-warning' : 'badge-success';
        const cardHtml = `
          <div class="ats-cand-card" draggable="true" ondragstart="dragTask(event, ${t.id})" style="cursor:grab;">
            <h5 style="margin-bottom:6px;">${t.title}</h5>
            <p>${t.project}</p>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px;">
              <span class="badge ${priorityColor}">${t.priority}</span>
              <span style="font-size:0.75rem; color:var(--text-secondary);">Due: ${t.due}</span>
            </div>
          </div>
        `;
        if (t.status === 'todo') todo.innerHTML += cardHtml;
        else if (t.status === 'in-progress') inprog.innerHTML += cardHtml;
        else if (t.status === 'done') done.innerHTML += cardHtml;
      });

      // Deadlines
      const deadBody = document.getElementById('emp-deadlines-tbody');
      deadBody.innerHTML = '';
      appState.tasks.forEach(t => {
        deadBody.innerHTML += `
          <tr class="${t.priority === 'High' ? 'style="background:rgba(244,63,94,0.05);"' : ''}">
            <td><strong>${t.title}</strong></td>
            <td>3 Days</td>
          </tr>
        `;
      });
    }

    // Drag Drop Task Handlers
    function dragTask(e, id) {
      e.dataTransfer.setData('text/plain', id);
    }
    function allowDrop(e) {
      e.preventDefault();
    }
    function dropTask(e, newStatus) {
      e.preventDefault();
      const id = parseInt(e.dataTransfer.getData('text/plain'));
      const task = appState.tasks.find(t => t.id === id);
      if (task) {
        task.status = newStatus;
        showToast(`Task status updated to ${newStatus.toUpperCase()}`, 'success');
        renderEmpTasks();
      }
    }

    function handleAddTask(e) {
      e.preventDefault();
      const title = document.getElementById('task-title').value;
      const project = document.getElementById('task-project').value;
      const priority = document.getElementById('task-priority').value;
      const due = document.getElementById('task-due').value;

      appState.tasks.push({
        id: appState.tasks.length + 1,
        title, project, priority, due,
        progress: 0,
        status: 'todo'
      });
      showToast('New task added.', 'success');
      closeModal('add-task-modal');
      renderEmpTasks();
    }

    function handleDailyWorkReport(e) {
      e.preventDefault();
      const text = document.getElementById('daily-report-text').value;
      showToast('Daily work report submitted successfully.', 'success');
      document.getElementById('daily-report-text').value = '';
    }

    // Meetings Controller
    function renderEmpMeetings() {
      const list = document.getElementById('emp-meetings-list');
      list.innerHTML = '';
      appState.meetings.forEach(m => {
        let tint = 'background: hsla(var(--warning), 0.1); border:1px solid hsla(var(--warning), 0.2);';
        let actBtn = `<button class="btn btn-primary" style="padding:6px 12px; font-size:0.75rem; margin-top:12px;" onclick="openModal('join-meeting-modal')">Join Session</button>`;
        
        if (m.status === 'Attended') {
          tint = 'background: hsla(var(--success), 0.1); border:1px solid hsla(var(--success), 0.2);';
          actBtn = `<span class="badge badge-success" style="margin-top:12px;">Attended</span>`;
        }
        if (m.status === 'Missed') {
          tint = 'background: hsla(var(--danger), 0.1); border:1px solid hsla(var(--danger), 0.2);';
          actBtn = `<span class="badge badge-danger" style="margin-top:12px;">Missed</span>`;
        }

        list.innerHTML += `
          <div class="emp-card" style="text-align:left; ${tint}">
            <strong>${m.title}</strong>
            <p style="font-size:0.8rem; color:var(--text-secondary); margin:4px 0;">Host: ${m.host} | Time: ${m.time}</p>
            ${actBtn}
          </div>
        `;
      });

      // Calendar
      const cal = document.getElementById('emp-meetings-calendar');
      cal.innerHTML = '';
      for(let d=1; d<=30; d++) {
        let highlight = '';
        if (d === 8) highlight = 'background:hsl(var(--warning)); color:#fff; border-radius:50%;';
        cal.innerHTML += `<div style="padding:8px; font-size:0.85rem; ${highlight}">${d}</div>`;
      }

      // Logs table
      const tbody = document.getElementById('emp-meetings-table-tbody');
      tbody.innerHTML = '';
      appState.meetings.forEach(m => {
        tbody.innerHTML += `
          <tr>
            <td>${m.date}</td>
            <td><strong>${m.title}</strong></td>
            <td>${m.host}</td>
            <td>45 Mins</td>
            <td><span class="badge ${m.status === 'Attended' ? 'badge-success' : m.status === 'Missed' ? 'badge-danger' : 'badge-warning'}">${m.status}</span></td>
          </tr>
        `;
      });
    }

    // Notifications Module
    function renderEmpNotifications() {
      const list = document.getElementById('emp-notif-full-list');
      list.innerHTML = '';
      appState.notifications.forEach(n => {
        list.innerHTML += `
          <div style="padding:15px; border-bottom:1px solid hsl(var(--border)); display:flex; justify-content:space-between; align-items:center; opacity: ${n.read ? '0.6' : '1'};">
            <div>
              <strong>${n.title}</strong>
              <p style="font-size:0.85rem; color:var(--text-secondary); margin-top:2px;">${n.desc}</p>
            </div>
            <span style="font-size:0.75rem; color:var(--text-secondary);">${n.time}</span>
          </div>
        `;
      });
    }

    function showNotificationPopup() {
      const popup = document.getElementById('notif-popup-body');
      popup.innerHTML = '';
      appState.notifications.slice(0, 3).forEach(n => {
        popup.innerHTML += `
          <div style="padding:12px; background:hsl(var(--bg-main)); border-radius:8px;">
            <strong>${n.title}</strong>
            <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:2px;">${n.desc}</p>
          </div>
        `;
      });
      openModal('notification-popup-modal');
    }

    function markAllNotificationsRead() {
      appState.notifications.forEach(n => n.read = true);
      document.getElementById('emp-nav-unread-count').style.display = 'none';
      showToast('All notifications marked read.', 'success');
      renderEmpNotifications();
    }

    function filterNotifications(val) {
      const list = document.getElementById('emp-notif-full-list');
      list.innerHTML = '';
      let filtered = appState.notifications;
      if (val !== 'All') filtered = filtered.filter(n => n.type === val);

      filtered.forEach(n => {
        list.innerHTML += `
          <div style="padding:15px; border-bottom:1px solid hsl(var(--border)); display:flex; justify-content:space-between; align-items:center;">
            <div>
              <strong>${n.title}</strong>
              <p style="font-size:0.85rem; color:var(--text-secondary); margin-top:2px;">${n.desc}</p>
            </div>
            <span style="font-size:0.75rem; color:var(--text-secondary);">${n.time}</span>
          </div>
        `;
      });
    }

    // Helpdesk / Support
    function renderEmpHelpdesk() {
      // Chat messages
      const chatCont = document.getElementById('chat-messages-container');
      chatCont.innerHTML = '';
      appState.chatMessages.forEach(msg => {
        chatCont.innerHTML += `
          <div class="chat-msg ${msg.sender === 'hr' ? 'hr' : 'emp'}">
            ${msg.message}
            <div style="font-size:0.65rem; text-align:right; opacity:0.8; margin-top:4px;">${msg.time}</div>
          </div>
        `;
      });
      chatCont.scrollTop = chatCont.scrollHeight;
    }

    function handleSendChatMessage(e) {
      e.preventDefault();
      const input = document.getElementById('chat-input-field');
      const text = input.value.trim();
      if (!text) return;

      const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      appState.chatMessages.push({ sender: 'emp', message: text, time: timeStr });
      input.value = '';
      renderEmpHelpdesk();

      // Show typing indicator
      const typing = document.getElementById('chat-typing');
      typing.style.display = 'block';

      setTimeout(() => {
        typing.style.display = 'none';
        appState.chatMessages.push({
          sender: 'hr',
          message: 'This is an automated HR support notification. A representative will get back to you shortly.',
          time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
        });
        renderEmpHelpdesk();
      }, 1500);
    }

    function handleRaiseTicket(e) {
      e.preventDefault();
      const title = document.getElementById('tkt-subject').value;
      const category = document.getElementById('tkt-category').value;
      const desc = document.getElementById('tkt-desc').value;

      appState.tickets.push({
        id: `TCK-${Math.floor(100 + Math.random() * 900)}`,
        title, category, status: 'Open',
        raisedOn: new Date().toISOString().split('T')[0],
        response: 'Awaiting HR Assignment.'
      });
      showToast('Support ticket raised.', 'success');
      document.getElementById('tkt-subject').value = '';
      document.getElementById('tkt-desc').value = '';
      renderEmpProfile();
    }

    function handleRaiseTicketModal(e) {
      e.preventDefault();
      const title = document.getElementById('modal-tkt-subject').value;
      const category = document.getElementById('modal-tkt-category').value;
      const desc = document.getElementById('modal-tkt-desc').value;

      appState.tickets.push({
        id: `TCK-${Math.floor(100 + Math.random() * 900)}`,
        title, category, status: 'Open',
        raisedOn: new Date().toISOString().split('T')[0],
        response: 'Awaiting review.'
      });
      showToast('Support ticket raised successfully.', 'success');
      closeModal('raise-ticket-modal');
      renderEmpProfile();
    }

    // Company Policies Acc Drawer
    function renderEmpPolicies() {
      const acc = document.getElementById('policies-accordion');
      const policies = [
        { title: 'Holiday Calendar', icon: 'fa-calendar-days', details: 'Full List of 15 Holidays: Republic Day: 26 Jan, Holi: 14 Mar, Good Friday: 18 Apr, Ambedkar Jayanti: 14 Apr, Labour Day: 1 May, Eid: 31 Mar, Independence Day: 15 Aug, Janmashtami: 16 Aug, Gandhi Jayanti: 2 Oct, Dussehra: 2 Oct, Diwali: 20 Oct, Diwali (Laxmi Puja): 21 Oct, Christmas: 25 Dec, New Year: 1 Jan, Regional Holiday (Pongal): 14 Jan.' },
        { title: 'Leave Policies', icon: 'fa-umbrella-beach', details: 'Casual Leave: 12 days/year, Sick Leave: 12 days/year, Earned Leave: 15 days/year, Maternity: 26 weeks, Paternity: 5 days, Compensatory Off: as earned.' },
        { title: 'Working Hours & Flex', icon: 'fa-clock', details: 'Standard Shift: Mon-Fri 9:00 AM - 6:00 PM (9 hrs including 1 hr lunch). Optional Saturday: 9:00 AM - 1:00 PM. Remote work policy: Up to 2 days/week WFH upon approval.' },
        { title: 'Employee Handbook', icon: 'fa-book', details: 'Contains full HR code of conduct guidelines. Click "Download" to fetch the complete PDF book from corporate repository.' },
        { title: 'Company Guidelines', icon: 'fa-scale-balanced', details: 'Dress Code, Device Usage security policies, Confidentiality & NDAs, Anti-Harassment workplace regulations, Conflict of interest policies.' },
        { title: 'Common Company Policies', icon: 'fa-building', details: 'Probation Period: 3 months, Notice Period: 30 days (junior) / 60 days (senior), Travel & Expense Reimbursement rules, Performance reviews (bi-annual), Increment Cycle (April).' }
      ];

      acc.innerHTML = policies.map((p, idx) => `
        <div class="policy-item" id="policy-${idx}">
          <div class="policy-trigger" onclick="togglePolicy(${idx})">
            <span><i class="fa-solid ${p.icon}" style="margin-right:12px; color:hsl(var(--primary));"></i> ${p.title}</span>
            <i class="fa-solid fa-chevron-down"></i>
          </div>
          <div class="policy-content">
            <p>${p.details}</p>
          </div>
        </div>
      `).join('');
    }

    function togglePolicy(idx) {
      const item = document.getElementById(`policy-${idx}`);
      item.classList.toggle('active');
    }
  </script>
</body>
</html>
