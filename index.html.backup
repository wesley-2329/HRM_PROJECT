    // HR ATS View Controller
    function renderATSBoard() {
      // Render source filters
      const filterCont = document.getElementById('ats-filters');
      const sources = ['All Sources', 'Job Portals', 'Career Page', 'Walk-In', 'Referrals'];
      filterCont.innerHTML = sources.map(src => {
        let count = 0;
        if (src === 'All Sources') count = appState.candidates.length;
        else if (src === 'Job Portals') count = appState.candidates.filter(c => c.source === 'Job Portal').length;
        else if (src === 'Referrals') count = appState.candidates.filter(c => c.source === 'Referral').length;
        else count = appState.candidates.filter(c => c.source === src).length;

        return `
          <button class="btn ${appState.selectedAtsSource === src ? 'btn-primary' : 'btn-secondary'}" onclick="filterATS('${src}')">
            ${src} <span class="badge ${appState.selectedAtsSource === src ? 'badge-info' : 'badge-primary'}">${count}</span>
          </button>
        `;
      }).join('');

      // Pipeline Columns
      const columns = ['applied', 'screening', 'interview', 'offered', 'selected', 'rejected'];
      const board = document.getElementById('ats-board');
      board.innerHTML = '';

      columns.forEach(col => {
        let colCandidates = appState.candidates.filter(c => c.stage === col);
        if (appState.selectedAtsSource !== 'All Sources') {
          let filterValue = appState.selectedAtsSource;
          if (filterValue === 'Job Portals') filterValue = 'Job Portal';
          if (filterValue === 'Referrals') filterValue = 'Referral';
          colCandidates = colCandidates.filter(c => c.source === filterValue);
        }

        let cardsHtml = '';
        colCandidates.forEach(cand => {
          let sourceBadgeColor = 'badge-info';
          if (cand.source === 'Walk-In') sourceBadgeColor = 'badge-success';
          if (cand.source === 'Referral') sourceBadgeColor = 'badge-warning';
          
          let stageLabel = '';
          if (col === 'interview') {
            stageLabel = `<div style="font-size:0.7rem; color:var(--text-secondary); margin-top:4px;"><i class="fa-solid fa-clock"></i> ${cand.interviewStage}</div>`;
          }

          cardsHtml += `
            <div class="ats-cand-card">
              <h5>${cand.name}</h5>
              <p>${cand.role}</p>
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="badge ${sourceBadgeColor}">${cand.source}</span>
                <span style="font-size:0.75rem; font-weight:600;">${cand.experience}</span>
              </div>
              ${stageLabel}
              <div class="ats-cand-actions">
                ${col !== 'selected' && col !== 'rejected' ? `<a onclick="moveCandidate(${cand.id})">Move Forward →</a>` : ''}
                ${col !== 'rejected' && col !== 'selected' ? `<a class="reject-link" onclick="rejectCandidate(${cand.id})">Reject</a>` : ''}
              </div>
            </div>
          `;
        });

        board.innerHTML += `
          <div class="ats-col">
            <div class="ats-col-header">
              <span>${col}</span>
              <span class="badge badge-primary">${colCandidates.length}</span>
            </div>
            <div class="ats-card-list">${cardsHtml}</div>
          </div>
        `;
      });

      // Render Selection Tables
      const selectedTbody = document.getElementById('ats-selected-tbody');
      selectedTbody.innerHTML = '';
      appState.candidates.filter(c => c.stage === 'selected').forEach(cand => {
        selectedTbody.innerHTML += `
          <tr>
            <td><strong>${cand.name}</strong></td>
            <td>${cand.role}</td>
            <td>${cand.source}</td>
            <td>Final HR & Offer</td>
            <td>
              <span class="badge ${cand.offerReleased === 'Yes' ? 'badge-success' : 'badge-warning'}">${cand.offerReleased === 'Yes' ? 'Released' : 'Pending'}</span>
              ${cand.offerReleased !== 'Yes' ? `<button class="btn btn-secondary" style="padding:4px 8px; font-size:0.7rem;" onclick="releaseOfferLetter(${cand.id})">Release Offer</button>` : ''}
            </td>
            <td>${cand.notes || '--'}</td>
          </tr>
        `;
      });

      const rejectedTbody = document.getElementById('ats-rejected-tbody');
      rejectedTbody.innerHTML = '';
      appState.candidates.filter(c => c.stage === 'rejected').forEach(cand => {
        rejectedTbody.innerHTML += `
          <tr>
            <td><strong>${cand.name}</strong></td>
            <td>${cand.role}</td>
            <td>${cand.source}</td>
            <td>${cand.stageRejectedAt || 'Screening'}</td>
            <td>${cand.rejectionReason || 'Under-qualified'}</td>
          </tr>
        `;
      });
    }

    function filterATS(src) {
      appState.selectedAtsSource = src;
      renderATSBoard();
    }

    function moveCandidate(id) {
      const cand = appState.candidates.find(c => c.id === id);
      if (!cand) return;
      const stages = ['applied', 'screening', 'interview', 'offered', 'selected'];
      const currentIdx = stages.indexOf(cand.stage);
      if (currentIdx < stages.length - 1) {
        cand.stage = stages[currentIdx + 1];
        if (cand.stage === 'interview') cand.interviewStage = 'Technical Round';
        showToast(`${cand.name} moved to ${cand.stage.toUpperCase()}`, 'success');
        renderATSBoard();
      }
    }

    function rejectCandidate(id) {
      const cand = appState.candidates.find(c => c.id === id);
      if (!cand) return;
      cand.stageRejectedAt = cand.stage;
      cand.stage = 'rejected';
      cand.rejectionReason = 'Skill alignment deficit';
      showToast(`${cand.name} rejected.`, 'error');
      renderATSBoard();
    }

    function releaseOfferLetter(id) {
      const cand = appState.candidates.find(c => c.id === id);
      if (cand) {
        cand.offerReleased = 'Yes';
        showToast(`Offer letter released for ${cand.name}`, 'success');
        renderATSBoard();
      }
    }

    function handleWalkinSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('walkin-name').value;
      const role = document.getElementById('walkin-role').value;
      const experience = document.getElementById('walkin-experience').value;
      const notes = document.getElementById('walkin-notes').value;

      appState.candidates.push({
        id: appState.candidates.length + 1,
        name, role, experience, notes,
        source: 'Walk-In',
        stage: 'applied',
        offerReleased: 'No'
      });
      showToast('Walk-in candidate added.', 'success');
      closeModal('add-walkin-modal');
      renderATSBoard();
    }

    function renderHRNotificationCenter() {
      const list = document.getElementById('hr-alert-list');
      list.innerHTML = '';
      appState.notifications.forEach(n => {
        list.innerHTML += `
          <div style="padding:15px; background:hsl(var(--bg-main)); border-radius:10px; display:flex; gap:12px; align-items:center;">
            <i class="fa-solid fa-bell" style="font-size:1.25rem; color:hsl(var(--primary));"></i>
            <div>
              <strong>${n.title}</strong>
              <p style="font-size:0.85rem; color:var(--text-secondary); margin-top:2px;">${n.desc}</p>
            </div>
          </div>
        `;
      });
    }

    // --- EMPLOYEE VIEW CONTROLLER LOGIC ---

    function renderEmpDashboard() {
      document.getElementById('emp-dash-task-count').innerText = appState.tasks.filter(t => t.status !== 'done').length;

      // Render tasks
      const tasksContainer = document.getElementById('emp-dash-tasks');
      tasksContainer.innerHTML = '';
      appState.tasks.slice(0, 3).forEach(t => {
        const priorityColor = t.priority === 'High' ? 'badge-danger' : t.priority === 'Medium' ? 'badge-warning' : 'badge-success';
        tasksContainer.innerHTML += `
          <div style="padding:12px; background:hsl(var(--bg-main)); border-radius:8px; display:flex; justify-content:space-between; align-items:center;">
            <div>
              <strong>${t.title}</strong>
              <div style="font-size:0.75rem; color:var(--text-secondary); margin-top:2px;">Due: ${t.due} | Project: ${t.project}</div>
            </div>
            <span class="badge ${priorityColor}">${t.priority}</span>
          </div>
        `;
      });

      // Render meetings
      const meetingsCont = document.getElementById('emp-dash-meetings');
      meetingsCont.innerHTML = '';
      appState.meetings.forEach(m => {
        let colorClass = 'background: hsla(var(--warning), 0.15); border-left: 4px solid hsl(var(--warning));';
        if (m.status === 'Attended') colorClass = 'background: hsla(var(--success), 0.15); border-left: 4px solid hsl(var(--success));';
        if (m.status === 'Missed') colorClass = 'background: hsla(var(--danger), 0.15); border-left: 4px solid hsl(var(--danger));';

        meetingsCont.innerHTML += `
          <div style="padding:12px; border-radius:8px; display:flex; justify-content:space-between; align-items:center; ${colorClass}">
            <div>
              <strong>${m.title}</strong>
              <div style="font-size:0.75rem; color:var(--text-secondary); margin-top:2px;">Host: ${m.host} | Time: ${m.time}</div>
            </div>
            <span class="badge badge-primary">${m.type}</span>
          </div>
        `;
      });

      // Training reminder
      const trCard = document.getElementById('emp-dash-training-card');
      const tr = appState.trainings[0];
      if (tr) {
        trCard.innerHTML = `
          <strong>${tr.name}</strong>
          <p style="font-size:0.8rem; color:var(--text-secondary); margin:4px 0 12px 0;">Assigned by ${tr.assignedBy} | Due: ${tr.deadline}</p>
          <div style="height:6px; background:hsl(var(--border)); border-radius:3px; overflow:hidden; margin-bottom:12px;">
            <div style="width:${tr.progress}%; height:100%; background:hsl(var(--primary));"></div>
          </div>
          <button class="btn btn-primary" style="padding:6px 12px; font-size:0.75rem;" onclick="switchEmpModule('emp-learning')">View Course</button>
        `;
      }

      // Notifs quick widget
      const notifsCont = document.getElementById('emp-dash-notifs');
      notifsCont.innerHTML = '';
      appState.notifications.slice(0, 3).forEach(n => {
        notifsCont.innerHTML += `
          <div style="padding:8px; border-bottom:1px solid hsl(var(--border)); font-size:0.8rem;">
            <strong>${n.title}</strong> - <span style="color:var(--text-secondary);">${n.desc}</span>
          </div>
        `;
      });
    }

    // Employee profile rendering
    let currentProfileTab = 'personal';
    function switchProfileTab(tab) {
      currentProfileTab = tab;
      document.getElementById('btn-profile-personal').className = `btn ${tab === 'personal' ? 'btn-primary' : 'btn-secondary'}`;
      document.getElementById('btn-profile-professional').className = `btn ${tab === 'professional' ? 'btn-primary' : 'btn-secondary'}`;
      document.getElementById('profile-tab-personal').style.display = tab === 'personal' ? 'block' : 'none';
      document.getElementById('profile-tab-professional').style.display = tab === 'professional' ? 'block' : 'none';
    }

    let isProfileEditing = false;
    let viewMaskedAadhaar = true;
    function renderEmpProfile() {
      const emp = appState.employees.find(e => e.id === 'EMP-2047'); // Arjun Mehta self
      if (!emp) return;

      const cont = document.getElementById('profile-personal-fields');
      const maskedVal = viewMaskedAadhaar ? 'XXXX-XXXX-XXXX' : emp.aadhaar;
      
      cont.innerHTML = `
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Employee ID</label>
          <p style="font-weight:700; margin-top:4px;">${emp.id}</p>
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Full Name</label>
          <input type="text" id="prof-edit-name" class="form-control" value="${emp.name}" ${!isProfileEditing ? 'readonly' : ''} style="margin-top:4px;">
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Email Address</label>
          <input type="email" id="prof-edit-email" class="form-control" value="${emp.email}" ${!isProfileEditing ? 'readonly' : ''} style="margin-top:4px;">
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Phone Number</label>
          <input type="text" id="prof-edit-phone" class="form-control" value="${emp.phone}" ${!isProfileEditing ? 'readonly' : ''} style="margin-top:4px;">
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Door / Flat No</label>
          <input type="text" id="prof-edit-door" class="form-control" value="${emp.address.door}" ${!isProfileEditing ? 'readonly' : ''} style="margin-top:4px;">
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Street / Area</label>
          <input type="text" id="prof-edit-street" class="form-control" value="${emp.address.street}" ${!isProfileEditing ? 'readonly' : ''} style="margin-top:4px;">
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">City</label>
          <input type="text" id="prof-edit-city" class="form-control" value="${emp.address.city}" ${!isProfileEditing ? 'readonly' : ''} style="margin-top:4px;">
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">State</label>
          <input type="text" id="prof-edit-state" class="form-control" value="${emp.address.state}" ${!isProfileEditing ? 'readonly' : ''} style="margin-top:4px;">
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">PIN Code</label>
          <input type="text" id="prof-edit-pin" class="form-control" value="${emp.address.pin}" ${!isProfileEditing ? 'readonly' : ''} style="margin-top:4px;">
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Emergency Contact</label>
          <input type="text" id="prof-edit-emg-name" class="form-control" value="${emp.emergency.name}" ${!isProfileEditing ? 'readonly' : ''} style="margin-top:4px;">
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Relation</label>
          <input type="text" id="prof-edit-emg-rel" class="form-control" value="${emp.emergency.relation}" ${!isProfileEditing ? 'readonly' : ''} style="margin-top:4px;">
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Blood Group</label>
          <p style="font-weight:700; margin-top:4px;">${emp.blood}</p>
        </div>
        <div>
          <label style="font-size:0.8rem; color:var(--text-secondary); font-weight:600;">Aadhaar Number</label>
          <div style="display:flex; align-items:center; gap:8px;">
            <p style="font-weight:700;" id="aadhaar-text-p">${maskedVal}</p>
            <button class="btn btn-secondary" style="padding:4px 8px; font-size:0.75rem;" onclick="toggleAadhaarMask()"><i class="fa-solid fa-eye"></i></button>
          </div>
        </div>
      `;

      // Render profile tickets
      const tktBody = document.getElementById('emp-profile-tickets-tbody');
      tktBody.innerHTML = '';
      appState.tickets.forEach(t => {
        tktBody.innerHTML += `
          <tr>
            <td><strong>${t.id}</strong></td>
            <td>${t.title}</td>
            <td>${t.category}</td>
            <td><span class="badge ${t.status === 'Open' ? 'badge-warning' : 'badge-success'}">${t.status}</span></td>
            <td>${t.raisedOn}</td>
            <td>${t.response || '--'}</td>
          </tr>
        `;
