        <!-- HR: System Settings -->
        <section id="hr-mod-settings-profile" class="hr-module" style="display:none;">
          <div class="card">
            <div class="card-title">System Settings</div>
            <form onsubmit="event.preventDefault(); showToast('Settings saved successfully.', 'success');">
              <div class="form-group">
                <label>Portal Primary Access Name</label>
                <input type="text" class="form-control" value="TalentSphere HR Portal">
              </div>
              <div class="form-group">
                <label>Automatic Payslip Release Date</label>
                <select class="form-control">
                  <option>1st of every Month</option>
