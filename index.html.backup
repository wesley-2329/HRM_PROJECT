            </div>
            <div class="form-group">
              <label><input type="checkbox" checked> SMS notifications</label>
            </div>
            <button class="btn btn-secondary" onclick="showToast('Preferences updated.', 'success')">Save Preferences</button>
          </div>
        </section>
      </div>
    </main>
  </div>

